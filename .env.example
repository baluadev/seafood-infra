# ============================================
# SeaShop Infrastructure — Environment Variables
# ============================================
# Copy to .env: cp .env.example .env
# Chỉ chứa config cho infrastructure services LOCAL

# === Ports ===
DB_PORT=5432
PGBOUNCER_PORT=6432
REDIS_PORT=6379

# === PostgreSQL ===
POSTGRES_DB=seashop_dev
POSTGRES_USER=seashop
POSTGRES_PASSWORD=seashop_secret_change_me

# === Redis ===
REDIS_PASSWORD=

# ============================================
# Supabase (PRODUCTION) — Điền sau khi có project
# ============================================
# Lấy từ: Supabase Dashboard → Project Settings → Database → Connect

# Transaction pooler (dùng cho runtime API)
SUPABASE_DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Direct connection (dùng cho prisma migrate)
SUPABASE_DIRECT_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# Lấy từ: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxx
